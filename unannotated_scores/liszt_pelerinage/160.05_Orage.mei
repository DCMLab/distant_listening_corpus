            <score>
               <scoreDef>
                  <pgHead func="first">
                     <rend halign="center" valign="top">
                        <rend type="subtitle" fontsize="large">5. Orage</rend>
                        <lb />
                        <rend type="title" fontsize="x-large">Années de Pèlerinage, Première année: Suisse, S.160</rend>
                     </rend>
                     <rend halign="left" valign="bottom">
                        <rend type="poet">But where of ye, O tempests! is the goal?<lb />Are ye like those within the human breast?<lb />Or do ye find, at length, like eagles, some high nest?<lb />                                                                           (Byron)</rend>
                     </rend>
                     <rend halign="right" valign="bottom">
                        <rend type="composer">Franz Liszt</rend>
                     </rend>
                  </pgHead>
