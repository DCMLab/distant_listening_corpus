            <score>
               <scoreDef>
                  <pgHead func="first">
                     <rend halign="center" valign="top">
                        <rend type="subtitle" fontsize="large">7. Eglogue</rend>
                        <lb />
                        <rend type="title" fontsize="x-large">Années de Pèlerinage, Première année: Suisse, S.160</rend>
                     </rend>
                     <rend halign="left" valign="bottom">
                        <rend type="poet">The morn is up again, the dewy morn,<lb />With breath all incense, and with cheek all bloom,<lb />Laughing the clouds away with playful scorn,<lb />And living as if earth contain'd no tomb, - ...<lb />                                                                      (Byron)</rend>
                     </rend>
                     <rend halign="right" valign="bottom">
                        <rend type="composer">Franz Liszt</rend>
                     </rend>
                  </pgHead>
