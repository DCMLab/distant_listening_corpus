                     <dir xml:id="mscore-STGi82KJY3E_AL.zfJrzGYE" type="mscore-staff-text" startid="#mscore-G-e1woIZisM_mBKkYu1EzYK">attacca subito</dir>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
