               <scoreDef>
                  <pgHead func="first">
                     <rend halign="center" valign="top">
                        <rend type="subtitle" fontsize="large">from: The Seasons, op. 37a</rend>
                        <lb />
                        <rend type="title" fontsize="x-large">12. December: Christmas</rend>
                     </rend>
                     <rend halign="left" valign="bottom">
                        <rend type="poet">«Раз в крещенский вечерок<lb />Девушки гадали:<lb />За ворота башмачок,<lb />Сняв с ноги, бросали…»<lb /><lb />(Жуковский)</rend>
                     </rend>
                     <rend halign="right" valign="bottom">
                        <rend type="composer">Pyotr Ilyich Tchaikovsky</rend>
                     </rend>
                  </pgHead>
