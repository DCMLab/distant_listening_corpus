            <score>
               <scoreDef>
                  <pgHead func="first">
                     <rend halign="center" valign="top">
                        <rend type="title" fontsize="x-large">1. January: At the Fireside</rend>
                        <lb />
                        <rend type="subtitle" fontsize="large">from: The Seasons, op. 37a</rend>
                     </rend>
                     <rend halign="left" valign="bottom">
                        <rend type="poet">«И мирной неги уголок<lb />Ночь сумраком одела,<lb />В камине гаснет огонёк,<lb />И свечка нагорела».<lb /><lb />(Пушкин)</rend>
                     </rend>
                     <rend halign="right" valign="bottom">
                        <rend type="composer">Pyotr Ilyich Tchaikovsky</rend>
                     </rend>
                  </pgHead>
                  <staffGrp>
                     <staffGrp bar.thru="true" symbol="brace">
                        <label>Piano</label>
                        <labelAbbr>Pno.</labelAbbr>
