            <score>
               <scoreDef>
                  <pgHead func="first">
                     <rend halign="center" valign="top">
                        <rend type="subtitle" fontsize="large">from: The Seasons, op. 37a</rend>
                        <lb />
                        <rend type="title" fontsize="x-large">4. April: Snowdrop</rend>
                     </rend>
                     <rend halign="left" valign="bottom">
                        <rend type="poet">«Голубенький, чистый подснежник – цветок,<lb />А подле сквозистый последний снежок.<lb />Последние слёзы о горе былом<lb />И первые грёзы о счастье ином».<lb /><lb />(Майков)</rend>
                     </rend>
                     <rend halign="right" valign="bottom">
                        <rend type="composer">Pyotr Ilyich Tchaikovsky</rend>
                     </rend>
                  </pgHead>
                  <staffGrp>
                     <staffGrp bar.thru="true" symbol="brace">
