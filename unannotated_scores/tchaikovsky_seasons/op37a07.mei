               <scoreDef>
                  <pgHead func="first">
                     <rend halign="center" valign="top">
                        <rend type="subtitle" fontsize="large">from: The Seasons, op. 37a</rend>
                        <lb />
                        <rend type="title" fontsize="x-large">7. July: Song of the Reaper</rend>
                     </rend>
                     <rend halign="left" valign="bottom">
                        <rend type="poet">«Раззудись, плечо,<lb />Размахнись, рука!<lb />Ты пахни в лицо,<lb />Ветер с полудня!»<lb /><lb />(Кольцов)</rend>
                     </rend>
                     <rend halign="right" valign="bottom">
                        <rend type="composer">Pyotr Ilyich Tchaikovsky</rend>
                     </rend>
                  </pgHead>
                  <staffGrp>
