            <score>
               <scoreDef>
                  <pgHead func="first">
                     <rend halign="center" valign="top">
                        <rend type="title" fontsize="x-large">3. March: Song of the Lark</rend>
                        <lb />
                        <rend type="subtitle" fontsize="large">from: The Seasons, op. 37a</rend>
                     </rend>
                     <rend halign="left" valign="bottom">
                        <rend type="poet">«Поле зыблется цветами,<lb />В небе льются света волны,<lb />Вешних жаворонков пенья<lb />Голубые бездны полны».<lb /><lb />(Майков)</rend>
                     </rend>
                     <rend halign="right" valign="bottom">
                        <rend type="composer">Pyotr Ilyich Tchaikovsky</rend>
                     </rend>
                  </pgHead>
                  <staffGrp>
                     <staffGrp bar.thru="true" symbol="brace">
                        <label>Piano</label>
                        <labelAbbr>Pno.</labelAbbr>
