               <scoreDef>
                  <pgHead func="first">
                     <rend halign="center" valign="top">
                        <rend type="title" fontsize="x-large">10. October: Autumn Song</rend>
                        <lb />
                        <rend type="subtitle" fontsize="large">from: The Seasons, op. 37a</rend>
                     </rend>
                     <rend halign="left" valign="bottom">
                        <rend type="poet">«Осень, обсыпается весь наш бедный сад,<lb />Листья пожелтелые по ветру летят».<lb /><lb />(Толстой)</rend>
                     </rend>
                     <rend halign="right" valign="bottom">
                        <rend type="composer">Pyotr Ilyich Tchaikovsky</rend>
                     </rend>
                  </pgHead>
