               <scoreDef>
                  <pgHead func="first">
                     <rend halign="center" valign="top">
                        <rend type="title" fontsize="x-large">6. June: Barcarolle</rend>
                        <lb />
                        <rend type="subtitle" fontsize="large">from: The Seasons, op. 37a</rend>
                     </rend>
                     <rend halign="left" valign="bottom">
                        <rend type="poet">«Выйдем на берег, там волны<lb />Ноги нам будут лобзать,<lb />Звёзды с таинственной грустью<lb />Будут над нами сиять».<lb /><lb />(Плещеев)</rend>
                     </rend>
                     <rend halign="right" valign="bottom">
                        <rend type="composer">Pyotr Ilyich Tchaikovsky</rend>
                     </rend>
                  </pgHead>
