            <score>
               <scoreDef>
                  <pgHead func="first">
                     <rend halign="center" valign="top">
                        <rend type="subtitle" fontsize="large">from: The Seasons, op. 37a</rend>
                        <lb />
                        <rend type="title" fontsize="x-large">9. September: Hunting Song</rend>
                     </rend>
                     <rend halign="left" valign="bottom">
                        <rend type="poet">«Пора, пора! Рога трубят;<lb />Псари в охотничьих уборах<lb />Чем свет уж на конях сидят;<lb />Борзые прыгают на сворах».<lb /><lb />(Пушкин)</rend>
                     </rend>
                     <rend halign="right" valign="bottom">
                        <rend type="composer">Pyotr Ilyich Tchaikovsky</rend>
                     </rend>
                  </pgHead>
                  <staffGrp>
                     <staffGrp bar.thru="true" symbol="brace">
                        <label>Klavier</label>
                        <labelAbbr>Klav.</labelAbbr>
